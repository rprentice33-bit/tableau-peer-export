<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="org.ihaconnect.extensions.peercomparisonexport" extension-version="1.2.1">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Creates a focused, paginated peer-comparison PDF from the currently filtered summary data in a configured dashboard worksheet.</description>
    <author name="Indiana Hospital Association" email="YOUR-EMAIL@ihaconnect.org" organization="Indiana Hospital Association" website="https://www.ihaconnect.org"/>
    <min-api-version>1.10</min-api-version>
    <source-location>
      <url>https://YOUR-HTTPS-HOST/tableau-peer-export/index.html</url>
    </source-location>
    <icon></icon>
    <context-menu>
      <configure-context-menu-item/>
    </context-menu>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Peer Comparison Export</text>
    </resource>
  </resources>
</manifest>
