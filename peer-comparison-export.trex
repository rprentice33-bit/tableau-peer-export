<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="org.ihaconnect.extensions.peercomparisonexport" extension-version="1.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Creates a paginated PDF from the currently filtered summary data in a configured dashboard worksheet.</description>
    <author name="Indiana Hospital Association" organization="Indiana Hospital Association" website="https://www.ihaconnect.org"/>
    <min-api-version>1.10</min-api-version>
    <source-location>
      <url>https://rprentice33-bit.github.io/tableau-peer-export/index.html</url>
    </source-location>
    <context-menu>
      <configure-context-menu-item/>
    </context-menu>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Peer Comparison Export</text>
    </resource>
  </resources>
</manifest>
